{
  "openapi": "3.1.0",
  "info": {
    "title": "mt-server management API",
    "version": "1.2.0",
    "description": "Same-origin API used by the embedded management interface. Secret values are never returned after creation."
  },
  "servers": [{ "url": "https://api.example.com/admin/api/v1" }],
  "paths": {
    "/status": {
      "get": {
        "summary": "Get management status",
        "operationId": "getManagementStatus",
        "security": [],
        "responses": { "200": { "description": "Setup and runtime status, including the restart-local pre-authentication CSRF token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StatusResponse" } } } } }
      }
    },
    "/setup": {
      "post": {
        "summary": "Initialize the service",
        "operationId": "initializeService",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetupRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Initialized; includes the first raw device token exactly once",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetupResponse" } } },
            "headers": { "X-MT-State-Warning": { "$ref": "#/components/headers/StateWarning" } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/session": {
      "get": {
        "summary": "Get the current administrator session",
        "operationId": "getAdminSession",
        "responses": { "200": { "description": "Current CSRF token" }, "401": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "summary": "Create an administrator session",
        "operationId": "createAdminSession",
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": { "200": { "description": "Administrator session created" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "summary": "Delete the administrator session",
        "operationId": "deleteAdminSession",
        "responses": { "200": { "description": "Administrator session deleted" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/settings/qweather": {
      "get": { "summary": "Get masked QWeather settings", "operationId": "getQWeatherSettings", "responses": { "200": { "description": "Masked QWeather settings" } } },
      "put": {
        "summary": "Test and replace QWeather settings",
        "operationId": "replaceQWeatherSettings",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QWeatherInput" } } } },
        "responses": {
          "200": { "description": "Tested current weather and alerts, persisted, activated, and returned current weather verification", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerificationResponse" } } }, "headers": { "X-MT-State-Warning": { "$ref": "#/components/headers/StateWarning" } } },
          "400": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/settings/qweather/test": {
      "post": {
        "summary": "Test candidate QWeather settings",
        "operationId": "testQWeatherSettings",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QWeatherInput" } } } },
        "responses": {
          "200": { "description": "Current-weather and alert connection tests passed without persistence", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerificationResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/settings/admin-origins": {
      "get": {
        "summary": "List persistent management HTTPS origins",
        "operationId": "listAdminOrigins",
        "responses": {
          "200": { "description": "Origin policy mode and configured origins", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminOriginsResponse" } } } },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "summary": "Add and immediately activate a management HTTPS origin",
        "operationId": "addAdminOrigin",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["origin"], "properties": { "origin": { "type": "string", "format": "uri", "examples": ["https://admin.example.com"] } } } } } },
        "responses": {
          "201": { "description": "Origin persisted and activated without invalidating existing sessions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminOrigin" } } }, "headers": { "X-MT-State-Warning": { "$ref": "#/components/headers/StateWarning" } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/settings/admin-origins/{id}": {
      "delete": {
        "summary": "Remove a management origin and invalidate all administrator sessions",
        "operationId": "removeAdminOrigin",
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string", "minLength": 43, "maxLength": 43 } }],
        "responses": {
          "204": { "description": "Origin removed and all sessions invalidated", "headers": { "X-MT-State-Warning": { "$ref": "#/components/headers/StateWarning" } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/diagnostics": {
      "get": {
        "summary": "Get privacy-preserving runtime diagnostics",
        "operationId": "getRuntimeDiagnostics",
        "responses": {
          "200": { "description": "Process-local provider and cache diagnostics", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DiagnosticsResponse" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/device-tokens": {
      "get": { "summary": "List device tokens", "operationId": "listDeviceTokens", "responses": { "200": { "description": "Named token metadata without hashes or raw values" } } },
      "post": {
        "summary": "Create a device token",
        "operationId": "createDeviceToken",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 64 } } } } } },
        "responses": { "201": { "description": "Raw token returned exactly once", "headers": { "X-MT-State-Warning": { "$ref": "#/components/headers/StateWarning" } } }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/device-tokens/{id}": {
      "delete": {
        "summary": "Revoke a device token",
        "operationId": "revokeDeviceToken",
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Token revoked", "headers": { "X-MT-State-Warning": { "$ref": "#/components/headers/StateWarning" } } }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/account/password": {
      "put": {
        "summary": "Change the administrator password",
        "operationId": "changeAdminPassword",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["current_password", "new_password"], "properties": { "current_password": { "type": "string" }, "new_password": { "type": "string", "description": "At least 12 Unicode code points and at most 128 UTF-8 bytes.", "minLength": 12, "maxLength": 128 } } } } } },
        "responses": { "200": { "description": "Password updated and all sessions invalidated", "headers": { "X-MT-State-Warning": { "$ref": "#/components/headers/StateWarning" } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    }
  },
  "security": [{ "adminSession": [] }],
  "components": {
    "securitySchemes": {
      "adminSession": { "type": "apiKey", "in": "cookie", "name": "mt_admin_session" }
    },
    "headers": {
      "StateWarning": { "description": "The state file was renamed successfully, but directory durability could not be confirmed.", "schema": { "type": "string", "const": "durability_unconfirmed" } }
    },
    "responses": {
      "Error": { "description": "Stable JSON error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
    },
    "schemas": {
      "StatusResponse": {
        "type": "object",
        "required": ["configured", "status", "version", "secure_transport", "admin_origin_mode", "state_durability", "csrf_token"],
        "properties": {
          "configured": { "type": "boolean" },
          "status": { "type": "string", "enum": ["setup_required", "ready", "unavailable"] },
          "version": { "type": "string" },
          "secure_transport": { "type": "boolean" },
          "admin_origin_mode": { "type": "string", "enum": ["proxy_allowlist", "direct_same_origin"] },
          "state_durability": { "type": "string", "enum": ["not_applicable", "confirmed", "unconfirmed"] },
          "csrf_token": { "type": "string" }
        }
      },
      "QWeatherInput": {
        "type": "object",
        "required": ["api_host", "project_id", "credential_id", "test_location"],
        "properties": {
          "api_host": { "type": "string" },
          "project_id": { "type": "string" },
          "credential_id": { "type": "string" },
          "private_key_pem": { "type": "string", "description": "Required during setup; omission retains the existing key during updates." },
          "test_location": { "$ref": "#/components/schemas/TestLocation" }
        }
      },
      "TestLocation": {
        "type": "object",
        "description": "Ephemeral browser location used only for this verification request and never persisted.",
        "required": ["latitude", "longitude"],
        "properties": {
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
		  "city": { "type": "string", "maxLength": 128 },
		  "region": { "type": "string", "maxLength": 128 },
		  "country": { "type": "string", "maxLength": 128 },
          "timezone": { "type": "string", "maxLength": 128 }
        }
      },
      "SetupRequest": {
		"type": "object",
		"required": ["password", "qweather", "device_name"],
		"properties": {
		  "password": { "type": "string", "description": "At least 12 Unicode code points and at most 128 UTF-8 bytes.", "minLength": 12, "maxLength": 128 },
		  "qweather": { "$ref": "#/components/schemas/QWeatherInput" },
		  "device_name": { "type": "string", "minLength": 1, "maxLength": 64 },
		  "admin_origins": { "type": "array", "maxItems": 16, "uniqueItems": true, "description": "Persistent HTTPS origins. Proxy mode requires the current request Origin to be included.", "items": { "type": "string", "format": "uri", "examples": ["https://admin.example.com"] } }
        }
      },
      "AdminOrigin": {
        "type": "object",
        "required": ["id", "origin"],
        "properties": {
          "id": { "type": "string", "description": "Base64URL-encoded SHA-256 of the canonical origin", "minLength": 43, "maxLength": 43 },
          "origin": { "type": "string", "format": "uri", "examples": ["https://admin.example.com"] }
        }
      },
      "AdminOriginsResponse": {
        "type": "object",
        "required": ["mode", "maximum", "origins"],
        "properties": {
          "mode": { "type": "string", "enum": ["proxy_allowlist", "direct_same_origin"] },
          "maximum": { "type": "integer", "const": 16 },
          "origins": { "type": "array", "maxItems": 16, "items": { "$ref": "#/components/schemas/AdminOrigin" } }
        }
      },
      "Verification": {
        "type": "object",
        "required": ["source", "location", "tested_at", "updated_at", "data"],
        "properties": {
          "source": {
            "type": "object",
            "required": ["id", "name", "attribution_url"],
            "properties": {
              "id": { "type": "string", "const": "qweather" },
              "name": { "type": "string", "const": "QWeather" },
              "attribution_url": { "type": "string", "format": "uri" }
            }
          },
          "location": {
            "type": "object",
			"required": ["source", "provider", "precision"],
            "properties": {
              "city": { "type": "string" }, "region": { "type": "string" },
              "country": { "type": "string" }, "timezone": { "type": "string" },
			  "source": { "type": "string", "const": "browser" },
			  "provider": { "type": "string", "const": "browser" },
			  "precision": { "type": "string", "const": "coarse" },
			  "location_key": { "type": "string", "pattern": "^[a-f0-9]{16}$", "maxLength": 16, "description": "Opaque grid-scope identity derived from the normalized 0.1-degree grid; never contains coordinates or the client IP." }
            }
          },
          "tested_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "data": { "type": "object", "description": "Normalized metric current-weather fields" }
        }
      },
      "VerificationResponse": {
        "type": "object",
        "required": ["status", "verification", "tested_capabilities"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "saved"] },
          "public_key_fingerprint": { "type": "string" },
          "verification": { "$ref": "#/components/schemas/Verification" },
          "tested_capabilities": { "type": "array", "items": { "enum": ["current", "alerts", "geo_lookup"] }, "minItems": 2, "maxItems": 3 }
        }
      },
      "SetupResponse": {
        "type": "object",
        "required": ["csrf_token", "device_token", "device", "qweather_public_key_fingerprint", "verification", "tested_capabilities"],
        "properties": {
          "csrf_token": { "type": "string" },
          "device_token": { "type": "string" },
          "device": { "type": "object" },
          "qweather_public_key_fingerprint": { "type": "string" },
          "verification": { "$ref": "#/components/schemas/Verification" },
          "tested_capabilities": { "type": "array", "items": { "enum": ["current", "alerts", "geo_lookup"] }, "minItems": 2, "maxItems": 3 }
        }
      },
      "DiagnosticsResponse": {
        "type": "object",
        "required": ["generated_at", "runtime_started_at", "provider", "locations", "entries", "kinds"],
        "properties": {
          "generated_at": { "type": "string", "format": "date-time" },
          "runtime_started_at": { "type": "string", "format": "date-time" },
          "provider": { "$ref": "#/components/schemas/ProviderDiagnostics" },
          "last_success_at": { "type": "string", "format": "date-time" },
          "last_error_at": { "type": "string", "format": "date-time" },
          "last_error_class": { "type": "string", "enum": ["bad_request", "credentials", "rate_limit", "server", "response", "timeout", "cancelled", "unknown"] },
          "locations": { "type": "integer", "minimum": 0 },
          "entries": { "type": "integer", "minimum": 0 },
          "kinds": {
            "type": "object",
            "required": ["current", "hourly", "daily", "alerts"],
            "properties": {
              "current": { "$ref": "#/components/schemas/CacheKindDiagnostics" },
              "hourly": { "$ref": "#/components/schemas/CacheKindDiagnostics" },
              "daily": { "$ref": "#/components/schemas/CacheKindDiagnostics" },
              "alerts": { "$ref": "#/components/schemas/CacheKindDiagnostics" }
            }
          }
        }
      },
      "ProviderDiagnostics": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["ready", "blocked", "closed", "unavailable"] },
          "blocked_until": { "type": "string", "format": "date-time" }
        }
      },
      "CacheKindDiagnostics": {
        "type": "object",
        "required": ["entries", "fresh_entries", "stale_entries", "refreshing", "requests", "fresh_hits", "stale_hits", "fetch_successes", "fetch_failures"],
        "properties": {
          "entries": { "type": "integer", "minimum": 0 },
          "fresh_entries": { "type": "integer", "minimum": 0 },
          "stale_entries": { "type": "integer", "minimum": 0 },
          "refreshing": { "type": "integer", "minimum": 0 },
          "requests": { "type": "integer", "minimum": 0 },
          "fresh_hits": { "type": "integer", "minimum": 0 },
          "stale_hits": { "type": "integer", "minimum": 0 },
          "fetch_successes": { "type": "integer", "minimum": 0 },
          "fetch_failures": { "type": "integer", "minimum": 0 }
        }
      },
      "LoginRequest": { "type": "object", "required": ["password"], "properties": { "password": { "type": "string" } } },
      "ErrorResponse": {
        "type": "object", "required": ["error"],
        "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "description": "Stable error code. Origin management uses invalid_admin_origin, admin_origin_exists, admin_origin_limit_reached, admin_origin_not_found, current_admin_origin, and last_admin_origin.", "examples": ["origin_rejected", "csrf_rejected", "current_admin_origin", "qweather_test_busy"] }, "message": { "type": "string" }, "request_id": { "type": "string" } } } }
      }
    }
  }
}
