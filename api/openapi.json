{
  "openapi": "3.1.0",
  "info": {
    "title": "mt-server weather API",
    "version": "1.2.0",
    "description": "Versioned authenticated weather and location API implemented by mt-server. Weather data is provided by QWeather. When the device location headers are absent, the server may infer a coarse location from the client's public IP address."
  },
  "servers": [
    {
      "url": "https://api.example.com"
    }
  ],
  "paths": {
    "/api/v1/weather/current": {
      "get": {
        "summary": "Get current weather",
        "operationId": "getCurrentWeather",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/LocationLatitude"
          },
          {
            "$ref": "#/components/parameters/LocationLongitude"
          },
          {
            "$ref": "#/components/parameters/LocationProvider"
          },
          {
            "$ref": "#/components/parameters/LocationCity"
          },
          {
            "$ref": "#/components/parameters/LocationRegion"
          },
          {
            "$ref": "#/components/parameters/LocationCountry"
          },
          {
            "$ref": "#/components/parameters/LocationTimezone"
          }
        ],
        "responses": {
          "200": {
            "description": "Current weather",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/WeatherEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/CurrentWeather"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/CurrentWeatherResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidLocation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/LocationRateLimited"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/weather/hourly": {
      "get": {
        "summary": "Get 24-hour weather forecast",
        "operationId": "getHourlyWeather",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/LocationLatitude"
          },
          {
            "$ref": "#/components/parameters/LocationLongitude"
          },
          {
            "$ref": "#/components/parameters/LocationProvider"
          },
          {
            "$ref": "#/components/parameters/LocationCity"
          },
          {
            "$ref": "#/components/parameters/LocationRegion"
          },
          {
            "$ref": "#/components/parameters/LocationCountry"
          },
          {
            "$ref": "#/components/parameters/LocationTimezone"
          }
        ],
        "responses": {
          "200": {
            "description": "Up to 24 hourly forecasts",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/WeatherEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/HourlyWeather"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/HourlyWeatherResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidLocation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/LocationRateLimited"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/weather/daily": {
      "get": {
        "summary": "Get seven-day weather forecast",
        "operationId": "getDailyWeather",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/LocationLatitude"
          },
          {
            "$ref": "#/components/parameters/LocationLongitude"
          },
          {
            "$ref": "#/components/parameters/LocationProvider"
          },
          {
            "$ref": "#/components/parameters/LocationCity"
          },
          {
            "$ref": "#/components/parameters/LocationRegion"
          },
          {
            "$ref": "#/components/parameters/LocationCountry"
          },
          {
            "$ref": "#/components/parameters/LocationTimezone"
          }
        ],
        "responses": {
          "200": {
            "description": "Up to seven daily forecasts",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/WeatherEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/DailyWeather"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/DailyWeatherResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidLocation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/LocationRateLimited"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/weather/alerts": {
      "get": {
        "summary": "Get current weather alerts",
        "operationId": "getWeatherAlerts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/LocationLatitude"
          },
          {
            "$ref": "#/components/parameters/LocationLongitude"
          },
          {
            "$ref": "#/components/parameters/LocationProvider"
          },
          {
            "$ref": "#/components/parameters/LocationCity"
          },
          {
            "$ref": "#/components/parameters/LocationRegion"
          },
          {
            "$ref": "#/components/parameters/LocationCountry"
          },
          {
            "$ref": "#/components/parameters/LocationTimezone"
          }
        ],
        "responses": {
          "200": {
            "description": "Complete current alert snapshot; an empty item array means no alerts",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/WeatherEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WeatherAlerts"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/WeatherAlertsResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidLocation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/LocationRateLimited"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/location": {
      "get": {
        "summary": "Get the device's effective location",
        "operationId": "getDeviceLocation",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Returns the display-safe location that will be used for weather requests. The optional location headers win when provided in full; otherwise the location is inferred from the authenticated client's public IP when the deployment has IP inference enabled. The response never contains the client IP or coordinates.",
        "parameters": [
          {
            "$ref": "#/components/parameters/LocationLatitude"
          },
          {
            "$ref": "#/components/parameters/LocationLongitude"
          },
          {
            "$ref": "#/components/parameters/LocationProvider"
          },
          {
            "$ref": "#/components/parameters/LocationCity"
          },
          {
            "$ref": "#/components/parameters/LocationRegion"
          },
          {
            "$ref": "#/components/parameters/LocationCountry"
          },
          {
            "$ref": "#/components/parameters/LocationTimezone"
          }
        ],
        "responses": {
          "200": {
            "description": "Coarse device location metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationResponse"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/LocationResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidLocation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Check process liveness",
        "operationId": "getLiveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is alive"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Check service readiness",
        "operationId": "getReadiness",
        "security": [],
        "responses": {
          "200": {
            "description": "All modules are ready"
          },
          "503": {
            "description": "Setup is required or a module circuit is open"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "LocationLatitude": {
        "name": "X-MT-Location-Latitude",
        "in": "header",
        "required": false,
        "description": "Request latitude; validated and normalized by the server to a 0.1 degree grid. All three required headers must be present together; when all are absent the server infers a coarse location from the client IP.",
        "schema": {
          "type": "string",
          "maxLength": 32
        }
      },
      "LocationLongitude": {
        "name": "X-MT-Location-Longitude",
        "in": "header",
        "required": false,
        "description": "Request longitude; validated and normalized by the server to a 0.1 degree grid. All three required headers must be present together; when all are absent the server infers a coarse location from the client IP.",
        "schema": {
          "type": "string",
          "maxLength": 32
        }
      },
      "LocationProvider": {
        "name": "X-MT-Location-Provider",
        "in": "header",
        "required": false,
        "description": "Lowercase identifier declaring the source of the request location. All three required headers must be present together; when all are absent the server infers a coarse location from the client IP.",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
        }
      },
      "LocationCity": {
        "name": "X-MT-Location-City",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      },
      "LocationRegion": {
        "name": "X-MT-Location-Region",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      },
      "LocationCountry": {
        "name": "X-MT-Location-Country",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      },
      "LocationTimezone": {
        "name": "X-MT-Location-Timezone",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "InvalidLocation": {
        "description": "Device location headers are partially provided or invalid; the required headers must be present together or not at all",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "LocationRateLimited": {
        "description": "The authenticated device changed location grids too frequently",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid device token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Location or weather data is unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "GatewayTimeout": {
        "description": "The weather provider timed out",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
