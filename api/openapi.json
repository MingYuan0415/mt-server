    "schemas": {
      "WeatherEnvelope": {
        "type": "object",
        "required": [
          "schema_version",
          "source",
          "location",
          "fetched_at",
          "updated_at",
          "valid_until",
          "stale",
          "data"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          },
          "data": {}
        }
      },
      "Source": {
        "type": "object",
        "required": [
          "id",
          "name",
          "attribution_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "const": "qweather"
          },
          "name": {
            "type": "string",
            "const": "QWeather"
          },
          "attribution_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Location": {
        "type": "object",
        "required": [
          "source",
          "provider",
          "precision"
        ],
        "properties": {
          "city": {
            "type": "string",
            "description": "Display-only city name; the server may overlay a localized city name from the configured weather provider, otherwise the device-supplied or IP-inferred value is echoed back."
          },
          "district": {
            "type": "string",
            "description": "Display-only district or county name localized by the configured weather provider. Present only when localization succeeded; never echoed from the device headers."
          },
          "region": {
            "type": "string",
            "description": "Display-only region name; may be localized like city."
          },
          "country": {
            "type": "string",
            "description": "ISO 3166 alpha-2 country code; never localized."
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone; may be localized like city."
          },
          "source": {
            "type": "string",
            "enum": [
              "device",
              "ip"
            ]
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
          },
          "precision": {
            "type": "string",
            "enum": [
              "city",
              "coarse"
            ]
          },
          "location_key": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$",
            "maxLength": 16,
            "description": "Opaque scope identity derived deterministically by the server from the normalized 0.1-degree grid. It does not contain coordinates or the client IP, is stable for the same grid, and changes when the grid changes. Devices should compare this value to detect location-scope changes; display fields are for presentation only."
          }
        }
      },
      "LocationResponse": {
        "type": "object",
        "required": [
          "schema_version",
          "location"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "accuracy_radius_km": {
            "type": "integer",
            "minimum": 1
          },
          "localization": {
            "type": "object",
